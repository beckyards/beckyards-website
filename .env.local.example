# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase project (create at supabase.com/dashboard) — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role secret key — admin routes only, never exposed to the browser
SUPABASE_SERVICE_ROLE_KEY=

# The only email allowed into /admin
ADMIN_EMAIL=

# Optional: contact-form email notifications via Resend (resend.com)
RESEND_API_KEY=

# Optional: salt for the daily one-way analytics visitor hash (any random string)
ANALYTICS_SALT=
